---
/**
 * Accueil d'une langue : page pilier (RECETTE §5). Ordre propre à ce site : le simulateur global
 * d'abord (« toutes mes aides »), puis le tableau des montants 2026 de chaque aide avec son
 * simulateur, puis le bloc citable replié et le texte. Texte dans src/content/accueil.ts.
 */
import PageLayout from '../layouts/PageLayout.astro';
import HomeCalc from './calc/HomeCalc';
import MiniSim from './calc/MiniSim';
import Clamp from './Clamp.astro';
import { HOME } from '../content/accueil';
import { route, type Locale } from '../i18n/routes';
import { helpers } from '../lib/helpers';
import { P } from '../lib/engine/params';
import type { SourceKey } from '../lib/engine/params';
import { LAST_UPDATED, AUTHOR_NAME } from '../data/site-config';
import { displayDate } from '../lib/format';
import { faqSchema, organizationSchema, websiteSchema, webPageSchema, webApplicationSchema } from '../lib/seo';
interface Props { lang: Locale }
const { lang } = Astro.props;
const x = HOME[lang];
const H = helpers(lang);
const path = route('home', lang);
const parts = x.body(H).split(/<!--mini:([A-Za-z0-9_]+)-->/);
const resume = x.resume(H);
const faqs = x.faqs(H);
const keys: SourceKey[] = ['spApl', 'arreteApl2026', 'cchD823', 'spPa', 'decretPa2026', 'spRsa', 'decretRsa2026', 'spAf', 'instructionPf2026', 'spArs', 'spNaissance', 'spPrepare', 'spAah', 'decretAah2026'];
const sources = keys.map((k) => ({ name: P.sources[k].label[lang], url: P.sources[k].url }));
const jsonLd = [websiteSchema(lang), organizationSchema(lang), webPageSchema({ name: x.h1, description: x.description, path, lang }), webApplicationSchema({ name: x.h1, description: x.description, path, lang }), faqSchema(faqs, lang)];
const fr = lang === 'fr';
---
<PageLayout title={x.title} description={x.description} lang={lang} jsonLd={jsonLd} faqs={faqs} sources={sources}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">{x.h1}</h1>
    <p class="mt-3 text-lg text-navy-700">{x.intro}</p>
    <p class="mt-3 text-sm text-navy-600">{fr ? 'Barèmes vérifiés le' : 'Rates checked on'} <time datetime={LAST_UPDATED}>{displayDate(LAST_UPDATED, fr ? 'fr-FR' : 'en-GB')}</time> · {fr ? 'par' : 'by'} <a href={route('about', lang)} class="underline">{AUTHOR_NAME}</a> · <a href={route('method', lang)} class="underline">{fr ? 'Méthode de calcul' : 'Calculation method'}</a></p>
  </header>
  <div data-outil><HomeCalc client:load lang={lang} /></div>
  <Clamp text={resume} lang={lang} id="clamp-home" sentences={2} class="mt-8" />
  <section class="mt-10">
    <h2 class="text-2xl font-bold text-navy-900">{x.gridTitle}</h2>
    <div class="not-prose mt-4 overflow-x-auto">
      <table class="w-full text-sm">
        <thead><tr>
          <th scope="col" class="border-b border-navy-300 px-3 py-2 text-left font-semibold text-navy-900">{fr ? 'Aide' : 'Benefit'}</th>
          <th scope="col" class="border-b border-navy-300 px-3 py-2 text-right font-semibold text-navy-900">{fr ? 'Montant 2026' : '2026 amount'}</th>
          <th scope="col" class="border-b border-navy-300 px-3 py-2 text-left font-semibold text-navy-900">{fr ? 'Simulateur' : 'Calculator'}</th>
        </tr></thead>
        <tbody>
          {x.grid(H).map(([aide, montant, id, lien]) => (
            <tr><td class="border-b border-navy-100 px-3 py-2 text-navy-800">{aide}</td><td class="tabular-nums border-b border-navy-100 px-3 py-2 text-right text-navy-900">{montant}</td><td class="border-b border-navy-100 px-3 py-2"><a href={route(id, lang)} class="font-medium text-accent-700 underline">{lien}</a></td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
  <div class="prose prose-slate max-w-none">
    {parts.map((p, i) => i % 2 === 0 ? <Fragment set:html={p} /> : <MiniSim client:load kind={p} lang={lang} href={route('simulateur-apl', lang)} />)}
  </div>
</PageLayout>
