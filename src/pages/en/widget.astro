---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/housing-aid-calculator/" title="French housing aid (APL) calculator 2026" width="100%" height="1000" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the 2026 French Housing Aid Calculator, Free of Charge" description="Embed the French housing aid (APL) calculator in an iframe for free: one code to copy, no sign-up, no cookie, October 2026 scale updated automatically on your page." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Widget', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Widget' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed the housing aid calculator</h1>
    <p class="mt-3 text-lg text-navy-700">One code to copy, no sign-up, no fee. Expat associations, student unions, relocation agencies and letting agents install it in a minute.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <p>Terms: the link under the calculator stays visible, the calculator is not altered, and it comes with no warranty. The scale is updated on this site every 1 October for housing aid, so your page stays current with no effort. French version: <code>{`${SITE_URL}/embed/simulateur-apl/`}</code>.</p>
    <p>No visitor data reaches us: the sum runs in their browser and the iframe sets no cookie. Questions: <a href={route('contact', lang)}>contact page</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src="/embed/housing-aid-calculator/" title="French housing aid (APL) calculator 2026" width="100%" height="1000" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
